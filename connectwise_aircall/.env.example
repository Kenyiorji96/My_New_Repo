# ConnectWise PSA API Configuration
# Copy this file to .env and fill in your credentials

# API Base URL (your ConnectWise instance)
CW_BASE_URL=https://connect.atlantic-it.net/v4_6_release/apis/3.0

# ConnectWise Company ID
CW_COMPANY_ID=your_company_id

# API Public Key (from Setup > API Members)
CW_PUBLIC_KEY=your_public_key

# API Private Key (from Setup > API Members)
CW_PRIVATE_KEY=your_private_key

# Client ID (registered at developer.connectwise.com)
CW_CLIENT_ID=your_client_id

# Output Configuration (optional)
OUTPUT_DIR=output
CSV_PREFIX=aircall_list
